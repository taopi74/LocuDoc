{
  "expo": {
    "name": "DocKit",
    "slug": "notype",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dockit",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.dockit.app",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.dockit.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "DocKit needs access to your photos so you can edit, resize and export them.",
          "cameraPermission": "DocKit needs camera access to capture photos for your documents."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow DocKit to save the images you create to your gallery.",
          "savePhotosPermission": "Allow DocKit to save the images you create to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "feedbackWeb3FormsKeys": []
    }
  }
}
